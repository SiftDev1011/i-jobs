{
  "name": "@ijobs/engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "test": "jest --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:types": "kysely-codegen --dialect postgres --out-file src/db/schema.ts --exclude-pattern '(public.schema_migrations)'",
    "source:try": "node dist/scripts/source-try.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1162.0",
    "@aws-sdk/client-sesv2": "3.1162.0",
    "@aws-sdk/s3-request-presigner": "3.1162.0",
    "@nestjs/common": "11.2.11",
    "@nestjs/core": "11.2.11",
    "@nestjs/platform-express": "11.2.11",
    "bullmq": "5.81.5",
    "fast-xml-parser": "5.11.2",
    "ioredis": "5.11.1",
    "jose": "6.2.15",
    "kysely": "0.28.19",
    "mammoth": "1.12.3",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.11",
    "@swc/core": "1.16.21",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.2",
    "kysely-codegen": "0.20.0",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "typescript": "5.9.3"
  }
}
