# Where the engine API is. The browser never calls it directly: pages and server actions do.
ENGINE_URL=http://localhost:3000
# This site's public address (links in emails, sharing).
PUBLIC_APP_URL=http://localhost:3001
# On Vercel: ENGINE_URL=https://ijobs-api.remotehustle.name.ng and PUBLIC_APP_URL=https://i-jobs.remotehustle.name.ng
# Show sample job cards on the landing page when the engine has none (never in production).
LANDING_SAMPLE_JOBS=true
