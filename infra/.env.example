# Copy to infra/.env on the server and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -base64 48

# --- Image ---
ENGINE_IMAGE=ghcr.io/siftdev1011/i-jobs/engine:latest

# --- Database and Redis (used by docker-compose) ---
# Use hex (openssl rand -hex 24): these go inside connection URLs, where / + @ break them.
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me-too
REDIS_PASSWORD=change-me-three
DB_POOL_MAX=10

# --- Cloudflare Tunnel: Zero Trust → Networks → Tunnels → create → copy the token.
# Public hostname: ijobs-api.remotehustle.name.ng → http://api:3000
# (not api.i-jobs.…: Cloudflare's free certificate only covers one level below remotehustle.name.ng)
CLOUDFLARE_TUNNEL_TOKEN=

# --- API ---
LOG_LEVEL=info
TRUST_PROXY=true
# Sites allowed to call the API from a browser, comma separated.
# Add School1's address when you have it, e.g. ,https://school1.com.ng
CORS_ORIGINS=https://i-jobs.remotehustle.name.ng,https://remotehustle.plug99.com.ng
PUBLIC_APP_URL=https://i-jobs.remotehustle.name.ng
IJOBS_SITE_SLUG=ijobs

# --- Sign-in (at least 32 characters each; changing them signs everyone out) ---
JWT_SECRET=
AUTH_PEPPER=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Encrypts secrets we must use later (ATS API keys, webhook signing secrets). openssl rand -hex 32
# Keep a copy somewhere safe: losing it means employers reconnect their ATS and partners recreate webhooks.
SECRETS_KEY=

# --- Email: Amazon SES (API v2) ---
MAIL_DRIVER=ses
MAIL_FROM_ACCOUNT=i-jobs <no-reply@mail.i-jobs.remotehustle.name.ng>
SES_CONFIGURATION_SET_ACCOUNT=ijobs-account
AWS_REGION=eu-north-1
# An IAM user allowed only ses:SendEmail and ses:SendRawEmail.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- SMS (optional). none = email-only: no phone sign-in, no phone invites and no free weeks
# (a free week is tied to a checked phone number). To turn texts on, set SMS_DRIVER=termii and fill
# in the Termii key and approved sender ID (DND route, so codes reach numbers on Do-Not-Disturb).
SMS_DRIVER=none
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com

# --- Backups (backup.sh) ---
BACKUP_REMOTE=r2-crypt:ijobs-backups
BACKUP_KEEP_DAYS=14

# --- AI: Groq free tier (console.groq.com → API keys). Without it, AI work waits; code-only paths still run.
GROQ_API_KEY=

# --- Job ingest ---
INGEST_ENABLED=true
# On-site and hybrid jobs are kept only in these countries. Remote jobs are always kept.
INGEST_ONSITE_COUNTRIES=NG
# Sent with every fetch so sources can contact us. Use a real page and inbox.
INGEST_USER_AGENT=ijobs-bot/1.0 (+https://i-jobs.remotehustle.name.ng/about; jobs@i-jobs.remotehustle.name.ng)
LINK_CHECKS_PER_RUN=200

# --- Source credentials. A source without its credentials is skipped, never failed. ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=
# Careerjet: the newer API key, or the classic affiliate id.
CAREERJET_API_KEY=
CAREERJET_AFFID=
# ReliefWeb: the appname they approved for us.
RELIEFWEB_APPNAME=
THEIRSTACK_API_KEY=
# Bluesky: optional. An app password (Settings → App passwords), not the account password.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Embeddings: Voyage (dashboard.voyageai.com → API keys). Without it, matching uses skills and titles only.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4
# Without a payment method on the Voyage account the limits are 3 requests and 10K tokens a minute.
# Adding one (free tokens still apply) raises them; then set these higher, e.g. 300 and 1000000.
VOYAGE_RPM=3
VOYAGE_TPM=10000

# --- CV storage: Cloudflare R2 (S3 API). Bucket private; token limited to this bucket.
# r2 in production. For laptops: local (files in STORAGE_DIR, signed /v1/dev/files links) or memory (tests).
STORAGE_DIR=.storage
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ijobs-files

# --- Applying ---
# Shared with the Cloudflare email worker (infra/email-worker). openssl rand -hex 32
INBOUND_EMAIL_SECRET=
# SES configuration set for the relay domain, with an SNS event destination (bounces, complaints) → /v1/hooks/ses
SES_CONFIGURATION_SET_RELAY=ijobs-relay
# The SNS topic ARNs allowed to post to /v1/hooks/ses, comma separated.
SES_SNS_TOPIC_ARNS=
AUTOPILOT_CANCEL_HOURS=2
EMPLOYER_DAILY_LIMIT=5

# --- Communities and money (see apps/engine/src/money/README.md) ---
PUBLIC_API_URL=https://ijobs-api.remotehustle.name.ng
PLATFORM_SHARE_BPS=2000
MINIMUM_PRICE_KOBO=500000
TRIAL_DAYS=7
GRACE_DAYS=3
PAYOUT_HOLD_DAYS=7
PAYOUT_MINIMUM_KOBO=500000

# --- Paga Collect. Sandbox first: https://beta-collect.paga.com, live: https://collect.paga.com
# paga = live payments. off = payments not set up yet (e.g. while Paga reviews your account): everything
# else runs, and pay buttons say "payments open soon". Switch to paga and fill in the keys when they arrive.
PAGA_DRIVER=paga
PAGA_BASE_URL=https://beta-collect.paga.com
PAGA_PUBLIC_KEY=
PAGA_SECRET_KEY=
PAGA_HASH_KEY=
PAGA_PAYEE_NAME=i-jobs by 99
